# ─── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=school_attendance
# Apply the idempotent schema migrations (migrations/*.sql) at startup.
AUTO_MIGRATE=true

# ─── Pipeline ─────────────────────────────────────────────────
# lite (MobileFaceNet, fast) or heavy (ArcFace R50, accurate).
# Changing MODE makes existing embeddings unusable: students must re-register.
MODE=heavy
SIMILARITY_THRESHOLD=0.40
# Duplicate-face threshold for registration. Empty = SIMILARITY_THRESHOLD.
DEDUP_THRESHOLD=

# ONNX Runtime execution providers, priority order (first available wins).
#   CPU only (default):  CPUExecutionProvider
#   NVIDIA GPU:          CUDAExecutionProvider,CPUExecutionProvider
#   Windows DirectML:    DmlExecutionProvider,CPUExecutionProvider
ONNX_PROVIDERS=CPUExecutionProvider
# Directory holding the .onnx models (buffalo_sc/ and buffalo_l/ subfolders).
MODEL_DIR=~/.insightface/models
# Max inference jobs at once (frames + registrations + camera).
INFERENCE_CONCURRENCY=2

# ─── Registration ─────────────────────────────────────────────
REQUIRED_UPLOAD=15
REQUIRED_VALID=7
# A photo's face must be at least this confident and this many pixels wide/tall.
REG_MIN_DET_SCORE=0.6
REG_MIN_FACE_PX=64
# Photos less similar than this to the set's most representative photo are dropped.
REG_CONSISTENCY_MIN=0.35
# Include the other student's number in "face already registered" replies.
REVEAL_DUPLICATE_MATCH=false

# ─── Security ─────────────────────────────────────────────────
# STRONGLY RECOMMENDED: set to require an X-API-Key header on every endpoint
# except /api/status and /healthz. Several keys comma-separated = rotation.
# Empty = endpoints open to anyone on the network (a warning is logged).
API_KEY=
# Comma-separated allowed CORS origins. Empty = no cross-origin browser access.
ALLOWED_ORIGINS=https://your-lms.example.com
# Maximum accepted size (bytes) per uploaded image. Default 10 MB.
MAX_UPLOAD_BYTES=10485760
# Whole-request cap in bytes. 0 = REQUIRED_UPLOAD x MAX_UPLOAD_BYTES + 1 MB.
MAX_REQUEST_BYTES=0
# Largest image (width x height pixels) that will be decoded. Blocks decompression bombs.
MAX_IMAGE_PIXELS=40000000

# ─── LMS integration ──────────────────────────────────────────
# Attendance is POSTed here as {"registration_number", "detected_at"} (UTC).
# Failed deliveries are retried with backoff (and survive restarts).
LMS_API_URL=
# Optional: sent as "Authorization: Bearer <token>".
LMS_API_TOKEN=
LMS_TIMEOUT=5
LMS_MAX_ATTEMPTS=10

# ─── Attendance ───────────────────────────────────────────────
# IANA timezone defining the attendance day, e.g. Asia/Karachi. Empty = server local.
ATTENDANCE_TZ=

# ─── Camera (server reads it directly) ────────────────────────
# Empty = no server-side camera.
#   0                                  -> local webcam 0
#   rtsp://USER:PASS@HOST:554/PATH     -> network camera (RTSP over TCP)
#   C:\path\video.mp4                  -> video file (testing)
# Use the camera's LOCAL account (often admin), NOT a cloud/Hik-Connect email.
# Special characters in USER/PASS are percent-encoded automatically.
# Hikvision main stream: /Streaming/Channels/101  (sub-stream: /102)
CAMERA_URL=
CAMERA_ID=camera-1
# Frames analysed per second.
CAMERA_FPS=2
